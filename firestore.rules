rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // コンテンツ（公開データ）は誰でも読み取り可、書き込みは認証済みユーザーのみ
    match /content/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // 画像（dataURL で保存）も同様
    match /images/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // 管理用メタデータ
    match /admin/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
